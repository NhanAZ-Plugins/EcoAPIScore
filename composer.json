{
    "name": "nhanaz-plugins/ecoapi-score",
    "description": "Generic ScoreHud tags backed by EcoAPI providers",
    "type": "pocketmine-plugin",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.51.1",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "NhanAZ\\EcoAPIScore\\": "src/NhanAZ/EcoAPIScore/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "stubs"
        ]
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --level=max --no-progress",
        "test": [
            "@php tests/tag-formatting.php",
            "@php tests/source-contract.php"
        ]
    }
}
